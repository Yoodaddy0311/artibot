{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ReviewOutput",
  "description": "Structured output schema for adversarial and code review findings",
  "type": "object",
  "required": ["verdict", "findings", "next_steps"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "warning"],
      "description": "Overall review verdict"
    },
    "findings": {
      "type": "array",
      "description": "List of discovered issues",
      "items": {
        "type": "object",
        "required": ["severity", "file", "description"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"],
            "description": "Issue severity level"
          },
          "file": {
            "type": "string",
            "description": "File path where the issue was found"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "Line number of the issue"
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Confidence level that this is a real issue"
          },
          "description": {
            "type": "string",
            "description": "Detailed description of the finding"
          },
          "suggestion": {
            "type": "string",
            "description": "Recommended fix or remediation"
          }
        },
        "additionalProperties": false
      }
    },
    "next_steps": {
      "type": "array",
      "description": "Prioritized remediation actions",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Review metadata",
      "properties": {
        "reviewer": {
          "type": "string",
          "description": "Reviewer agent or persona identifier"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of the review"
        },
        "scope": {
          "type": "string",
          "description": "Files or directories reviewed"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
