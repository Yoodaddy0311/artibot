    "teamStorage": {
      "config": "~/.claude/teams/{team-name}/config.json",
      "tasks": "~/.claude/tasks/{team-name}/"
    }
  },
  "autopilot": {
    "enabled": false,
    "defaultMode": "default",
    "modes": [
      "default",
      "night",
      "plan"
    ],
    "limits": {
      "maxDuration": "4h",
      "maxBudget": 2000000,
      "maxBuildFailures": 3,
      "maxTestFailures": 5,
      "contextThreshold": 0.85,
      "checkpointInterval": "30m"
    },
    "safety": {
      "pauseOnDanger": true,
      "blockSecretLeak": true,
      "blockExternalSend": true,
      "dangerousPatterns": [
        "force-push",
        "branch-delete",
        "db-drop",
        "rm-rf-root"
      ]
    },
    "phases": [
      "INTAKE",
      "PLAN",
      "EXECUTE",
      "CROSS_CHECK",
      "VERIFY",
      "IMPROVE",
      "REPORT"
    ],
    "paths": {
      "prdDir": "docs/PRD/",
      "reportDir": "reports/AUTOPILOT/",
      "sessionDir": "runtime/autopilot/"
    },
    "notification": {
      "onCompletion": true,
      "onPause": true,
      "channel": "PushNotification"
    },
    "mcp": {
      "enabled": false,
      "allowList": [
        "plugin:artibot:playwright",
        "plugin:artibot:context7"
      ],
      "blockExternal": true,
      "allowedPrefix": "plugin:artibot:",
      "denyHostPatterns": [
        "https?://(?!localhost|127\\.0\\.0\\.1|::1|0\\.0\\.0\\.0)",
        "\\.(s3|amazonaws|googleapis|blob\\.core\\.windows|firebaseio)\\."
      ],
      "comment": "MCP-driven Verification (P0-4): Artibot self-plugin MCPs allowed. External MCP/host blocked. opt-in via --mcp-verify."
    }
  },
  "git": {
    "autopilot": {
      "bypassPreCommitHooks": false,
      "bypassPrePushHooks": false,
      "closeOnStop": false,
      "commitStrategy": "semantic",
      "stashCheckpoint": {
        "enabled": true,
        "intervalMinutes": 30,
        "maxStashes": 10,
        "includeUntracked": true
      },
      "semanticCommit": {
        "enabled": true,
        "commitOnPhases": ["PLAN", "EXECUTE", "VERIFY", "REPORT"],
        "requireTestPass": true,
        "requireLintClean": true
      },
      "comment": "v4.7.2: bypass*Hooks default false (honour user pre-commit/pre-push hooks). v4.11.3: closeOnStop default false — Stop hook의 git-autopilot-close.js가 매 turn마다 commit/push를 만들어 history를 오염시키던 문제 차단. WIP interval save(git-autopilot-save.js)는 영향 없음. 이전 동작 복원: closeOnStop을 true로 토글. v4.14.0: commitStrategy 'semantic' — phase 완료 시에만 의미 커밋, stash checkpoint로 크래시 안전망 유지."
    }
  },
  "postWork": {
    "blindspot": {
      "enabled": true
    },
    "teachBack": {
      "enabled": true,
      "questions": 3
    },
    "comment": "Stop-hook post-work passes. blindspot = 검증 후 누락 점검(recommend-only). teachBack = 12세 해설+퀴즈3(정답 해설만, 게이트 없음). 켜려면 enabled:true."
  },
  "swarm": {
    "enabled": false,
    "optIn": false,
    "serverUrl": "http://localhost:3000",
    "_serverUrlPolicy": "DATA POLICY: 기본값은 localhost(self-hosted)로 고정합니다. 외부 swarm 서버로 데이터를 보내려면 (a) 직접 self-host 하거나 (b) ARTIBOT_SWARM_SERVER 환경변수로 명시 지정 + lib/privacy/allowlist.json 또는 ARTIBOT_ALLOW_EGRESS로 해당 호스트를 명시 허용해야 합니다. 어떤 외부 엔드포인트도 기본값으로 출하하지 않습니다(과거 run.app 기본값은 v4.x에서 제거됨, CHANGELOG 참조).",
    "syncInterval": "session",
    "localGlobalRatio": [
      0.3,
      0.7
    ],
    "differentialPrivacy": {
      "enabled": true,
      "epsilon": 1,
      "delta": 0.00001
    },
    "backend": "http",
    "_backendPolicy": "DATA POLICY: 기본 backend는 'http'(localhost self-hosted)로 고정해 출하합니다. 'git' backend는 HTTP egress guard를 우회(git 바이너리 push/pull)하므로 기본값으로 두지 않습니다. git 동기화를 쓰려면 backend를 'git'으로 명시 전환하고 gitRepoUrl에 본인 소유 private repo를 직접 지정하세요(SWARM_DEFAULTS와 일치).",
    "gitRepoUrl": null,
    "_gitRepoUrlWarning": "DATA POLICY: git backend 활성화(enabled:true + backend:'git') 시 여기 지정한 repo로 데이터가 push됩니다. 반드시 본인/내부 소유 private repo만 지정하고, 활성화 전 개인 데이터 포함 여부를 확인하세요. 기본값 null = 미설정(외부 전송 경로 없음)."
  },
  "automation": {
    "intentDetection": true,
    "ambiguityThreshold": 50,
    "supportedLanguages": [
      "en",
      "ko",
      "ja",
      "zh"
    ]
  },
  "context": {
    "importCacheTTL": 30000
  },
  "cognitive": {
    "router": {
      "threshold": 0.4,
