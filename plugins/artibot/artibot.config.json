    },
    "messageTypes": [
      "message",
      "broadcast",
      "shutdown_request",
      "shutdown_response",
      "plan_approval_response"
    ],
    "teamStorage": {
      "config": "~/.claude/teams/{team-name}/config.json",
      "tasks": "~/.claude/tasks/{team-name}/"
    }
  },
  "autopilot": {
    "enabled": false,
    "defaultMode": "default",
    "modes": [
      "default",
      "night",
      "plan"
    ],
    "limits": {
      "maxDuration": "4h",
      "maxBudget": 2000000,
      "maxBuildFailures": 3,
      "maxTestFailures": 5,
      "contextThreshold": 0.85,
      "checkpointInterval": "30m"
    },
    "safety": {
      "pauseOnDanger": true,
      "blockSecretLeak": true,
      "blockExternalSend": true,
      "dangerousPatterns": [
        "force-push",
        "branch-delete",
        "db-drop",
        "rm-rf-root"
      ]
    },
    "phases": [
      "INTAKE",
      "PLAN",
      "EXECUTE",
      "CROSS_CHECK",
      "VERIFY",
      "IMPROVE",
      "REPORT"
    ],
    "paths": {
      "prdDir": "docs/PRD/",
      "reportDir": "reports/AUTOPILOT/",
      "sessionDir": "runtime/autopilot/"
    },
    "notification": {
      "onCompletion": true,
      "onPause": true,
      "channel": "PushNotification"
    },
    "mcp": {
      "enabled": false,
      "allowList": [
        "plugin:artibot:playwright",
        "plugin:artibot:context7"
      ],
      "blockExternal": true,
      "allowedPrefix": "plugin:artibot:",
      "denyHostPatterns": [
        "https?://(?!localhost|127\\.0\\.0\\.1|::1|0\\.0\\.0\\.0)",
        "\\.(s3|amazonaws|googleapis|blob\\.core\\.windows|firebaseio)\\."
      ],
      "comment": "MCP-driven Verification (P0-4): only Artibot self-plugin MCPs allowed. External MCP/host blocked. opt-in via --mcp-verify."
    }
  },
  "swarm": {
    "enabled": true,
    "optIn": true,
    "serverUrl": "https://artibot-swarm-154860486472.asia-northeast3.run.app",
    "syncInterval": "session",
    "localGlobalRatio": [
      0.3,
      0.7
    ],
    "differentialPrivacy": {
      "enabled": true,
      "epsilon": 1,
      "delta": 0.00001
    },
    "backend": "git",
    "gitRepoUrl": "https://github.com/Yoodaddy0311/artibot-swarm.git"
  },
  "automation": {
    "intentDetection": true,
    "ambiguityThreshold": 50,
    "supportedLanguages": [
      "en",
      "ko",
      "ja",
      "zh"
    ]
  },
  "context": {
    "importCacheTTL": 30000
  },
  "cognitive": {
    "router": {
      "threshold": 0.4,
      "adaptRate": 0.05
    },
    "system1": {
      "maxLatency": 100,
      "minConfidence": 0.6
    },
    "system2": {
      "maxRetries": 3,
      "sandboxEnabled": true
    }
  },
  "learning": {
    "memoryScopes": {
      "user": "~/.claude/artibot/",
      "project": ".artibot/",
      "session": "in-memory"
    },
    "lifelong": {
      "batchSize": 50,
      "grpoGroupSize": 5
    },
    "knowledgeTransfer": {
      "promotionThreshold": 3,
      "demotionThreshold": 2
    },
    "schedule": {
      "enabled": true,
      "nightlyLearner": "3 2 * * *",
      "driftCheck": "7 6 * * 1",
      "nightlyGrpoTrainer": "30 2 * * *",
      "nightlyAgentPolicyTrainer": "45 2 * * *",
      "nightlySkillPolicyTrainer": "0 3 * * *",
      "nightlyJointPolicyTrainer": "15 3 * * *"
    },
    "hierarchicalMemory": {
      "enabled": true,
      "rolloutStage": "default-on",
      "workingTokenBudget": 200000,
      "episodicRetentionDays": 180,
      "semanticRetentionDays": -1,
      "archiveAfterDays": 365,
      "weights": {
        "working": 0.5,
        "episodic": 0.3,
        "semantic": 0.2
      },
      "promotion": {
        "minOccurrences": 3,
        "confidenceFloor": 0.85,
        "distinctSessions": 2
      },
      "demotion": {
        "idleDays": 180,
        "failureThreshold": 2
      }
    },
    "grpoRouting": {
      "enabled": true,
      "modelType": "linear",
      "policyPath": "~/.claude/artibot/policies/routing-policy-v1.json",
      "blendAlpha": 0.7,
      "alphaDecayPerWeek": 0.05,
      "alphaFloor": 0.3,
      "epsilonExplore": 0.05,
      "epsilonFloor": 0.01,
      "coldStartEpisodes": 200,
      "klPenalty": 0.01,
      "learningRate": 0.02,
      "snapshotCount": 3,
      "groupingLevels": [
        "fine",
        "medium",
        "coarse"
      ],
      "agentPolicy": {
        "enabled": false,
        "policyPath": "~/.claude/artibot/policies/agent-policy-v1.json",
        "temperature": 1
      },
      "skillPolicy": {
        "enabled": false,
        "policyPath": "~/.claude/artibot/policies/skill-policy-v1.json",
        "threshold": 0.5,
        "maxTriggers": 3
      },
      "jointPolicy": {
        "enabled": false,
        "policyPath": "~/.claude/artibot/policies/joint-policy-v1.json",
        "correlationWeight": 0.5
      }
    }
  },
  "visual": {
    "maxIterations": 3,
    "threshold": 0.95,
    "disableAnimations": true,
    "excludeSelectors": []
  },
  "runtime": {
    "middleware": [
      "router",
      "subagents",
      "tasks",
      "checkpoint",
      "memory",
      "skills",
      "guardrail",
      "token-usage",
      "cache-roi",
      "summarization"
    ],
    "effort": {
      "injectPrompt": true,
      "nativeApi": false,
      "budgetMap": {
        "xhigh": 128000,
        "high": 64000,
        "medium": 32000,
        "low": 16000
      }
    },
    "longContext": {
      "enabled": false,
      "betaHeader": "context-1m-2025-08-01",
      "activationThreshold": 180000
    }
  },
  "extensions": {
    "enabled": true,
    "searchPaths": [
      "~/.claude/plugins/"
    ],
    "dataPolicy": "local",
    "allowedDataPolicies": [
      "local",
      "artibot-swarm"
    ]
  },
  "ux": {
    "plainLanguage": {
      "enabled": false,
      "locale": "ko"
    },
    "skillLevel": "auto",
    "profilePath": "runtime/user-profile.json"
  },
  "dashboard": {
    "enabled": false,
    "showTeammates": true,
    "showEffort": true,
    "showTaskBudget": true
  },
  "ago": {
    "selfControlEnabled": true,
    "selfControl": {
      "masterEnabled": true,
      "firstRunMode": {
        "enabled": true,
        "observeRuns": 5,
        "statePath": "runtime/first-run-state.json"
      },
      "emergencyKillSwitch": {
        "enabled": true,
        "maxFailuresPerHour": 3,
        "cooldownHours": 24,
        "statePath": "runtime/kill-switch-state.json"
      },
      "autoCommit": {
        "enabled": true,
        "maxRiskLevel": "low",
        "requiredTestsPass": true,
        "requiredLintClean": true,
        "rollbackOnRegression": true
