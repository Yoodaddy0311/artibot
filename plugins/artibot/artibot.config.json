{
  "version": "4.31.0",
  "devProtocol": {
    "verifyMode": "advisory",
    "writeGuardMode": "block",
    "writeGuardModeComment": "pre-write-guard.js write-before-read enforcement. 'block' (default) = strict DEV protocol: existing files must be Read before Write/Edit (regression-safe, mirrors prior behavior). 'advisory' = warn-only (approve) — friendlier for non-developer/vibe-coding users at the cost of the strict read-before-write guarantee. Env override: ARTIBOT_WRITE_GUARD_MODE."
  },
  "agents": {
    "modelPolicy": {
      "high": {
        "model": "opus",
        "agents": [
          "orchestrator",
          "architect",
          "security-reviewer",
          "frontend-developer",
          "backend-developer",
          "code-reviewer",
          "tdd-guide",
          "database-reviewer",
          "mcp-developer",
          "typescript-pro",
          "planner",
          "refactor-cleaner",
          "build-error-resolver",
          "llm-architect",
          "devops-engineer",
          "performance-engineer",
          "e2e-runner",
          "marketing-strategist",
          "repo-benchmarker",
          "quality-reviewer",
          "spec-reviewer"
        ]
      },
      "medium": {
        "model": "sonnet",
        "agents": [
          "doc-updater",
          "content-marketer",
          "data-analyst",
          "presentation-designer",
          "seo-specialist",
          "cro-specialist",
          "ad-specialist"
        ]
      },
      "advisorStrategy": {
        "enabled": true,
        "executorModel": "sonnet",
        "advisorModel": "opus",
        "maxUses": 3,
        "triggerConditions": [
          "architecture-decision",
          "security-assessment",
          "complex-debugging",
          "cross-domain-analysis"
        ]
      },
      "fable": {
        "enabled": false,
        "allowlist": [],
        "comment": "Fable (claude-fable-5) tier isolation — opt-in ONLY. An agent resolves to fable ONLY when enabled===true AND its exact name is in allowlist AND it is not in the security denylist; every other fable request is demoted to opus. No automatic/heuristic fable selection exists. Effective cost vs Opus baseline is computed by lib/core/model-catalog.js#getCostFactor('fable') — do not duplicate the number here. Keep allowlist deliberate. Default enabled=false, allowlist=[] = zero fable usage, byte-identical legacy behavior."
      }
    },
    "categories": {
      "manager": [
        "orchestrator",
        "planner",
        "architect"
      ],
      "expert": [
        "security-reviewer",
        "frontend-developer",
        "backend-developer",
        "database-reviewer",
        "performance-engineer",
        "mcp-developer",
        "llm-architect",
        "typescript-pro",
        "devops-engineer"
      ],
      "builder": [
        "code-reviewer",
        "tdd-guide",
        "build-error-resolver",
        "refactor-cleaner"
      ],
      "support": [
        "doc-updater",
        "content-marketer",
        "e2e-runner",
        "marketing-strategist",
        "data-analyst",
        "presentation-designer",
        "seo-specialist",
        "cro-specialist",
        "ad-specialist",
        "repo-benchmarker"
      ]
    },
    "taskBased": {
      "code review": "code-reviewer",
      "security review": "security-reviewer",
      "architecture": "architect",
      "frontend": "frontend-developer",
      "backend": "backend-developer",
      "database": "database-reviewer",
      "build error": "build-error-resolver",
      "e2e test": "e2e-runner",
      "tdd": "tdd-guide",
      "plan": "planner",
      "refactor": "refactor-cleaner",
      "documentation": "doc-updater",
      "content": "content-marketer",
      "devops": "devops-engineer",
      "llm": "llm-architect",
      "mcp": "mcp-developer",
      "performance": "performance-engineer",
      "typescript": "typescript-pro",
      "benchmark": "repo-benchmarker",
      "marketing strategy": "marketing-strategist",
      "data analysis": "data-analyst",
      "presentation": "presentation-designer",
      "seo": "seo-specialist",
      "cro": "cro-specialist",
      "advertising": "ad-specialist",
      "swarm": "orchestrator",
      "team": "orchestrator"
    }
  },
  "team": {
    "enabled": true,
    "autoApply": true,
    "autoApplyTriggers": {
      "logic": "OR",
      "minSubtasks": 3,
      "minFiles": 3,
      "minComplexity": "high",
      "bypassIntents": [
        "question",
        "diagnose",
        "explain",
        "lookup"
      ],
      "excludeTrivial": {
        "maxLines": 50,
        "singleFile": true
      },
      "persistentTeam": true,
      "comment": "Tightened 2026-05-03: minComplexity high, minSubtasks/Files 3, maxLines 50, bypass intents added. Reduces team-routing for simple Q/diagnostic requests so non-trivial multi-domain work still triggers parallel teammates."
    },
    "engine": "claude-agent-teams",
    "envVar": "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS",
    "maxTeammates": null,
    "ctoAgent": "orchestrator",
    "delegationMode": true,
    "displayMode": "auto",
    "spawnStrategy": "on-demand-parallel",
    "worktreeIsolation": {
      "enabled": false,
      "defaultMode": "worktree-isolated",
      "mergeStrategy": "auto",
      "cleanupOnClose": true
    },
    "api": {
      "lifecycle": [
        "TeamCreate",
        "TeamDelete"
      ],
      "communication": [
        "SendMessage"
      ],
      "taskManagement": [
        "TaskCreate",
        "TaskUpdate",
        "TaskList",
        "TaskGet"
      ],
      "spawning": "Task(subagent_type, team_name, name)"
    },
    "gracefulDegradation": {
      "detection": "runtime-tool-availability",
      "modes": {
        "agent-teams": {
          "condition": "TeamCreate tool available",
          "requires": "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1",
          "capabilities": [
            "team-lifecycle",
            "p2p-messaging",
            "shared-tasks",
            "parallel-spawning"
          ],
          "platforms": [
            "claude-code"
          ]
        },
        "sub-agent": {
          "condition": "Task tool available BUT TeamCreate unavailable",
          "requires": "Claude Code (any version)",
          "capabilities": [
            "fire-and-forget-delegation",
            "parallel-spawning",
            "result-aggregation"
          ],
          "platforms": [
            "claude-code"
          ],
          "fallbackFrom": "agent-teams"
        },
        "direct": {
          "condition": "Neither TeamCreate nor Task tool available",
          "requires": "Any AI coding assistant",
          "capabilities": [
            "sequential-execution",
            "self-review"
          ],
          "platforms": [
            "gemini-cli",
            "codex-cli",
            "cursor",
            "windsurf",
            "antigravity"
          ],
          "fallbackFrom": "sub-agent"
        }
      },
      "detectionPriority": [
        "agent-teams",
        "sub-agent",
        "direct"
      ]
    },
    "delegationModeSelection": {
      "subAgent": {
        "condition": "complexity < 0.4 AND single domain AND steps < 3",
        "tools": [
          "Task"
        ],
        "communication": "one-way (result return only)"
      },
      "agentTeam": {
        "condition": "complexity >= 0.4 OR multi-domain OR steps >= 3",
        "tools": [
          "TeamCreate",
          "SendMessage",
          "TaskCreate",
          "TaskUpdate",
          "TaskList",
          "TeamDelete"
        ],
        "communication": "P2P bidirectional + shared task list"
      }
    },
    "levels": {
      "solo": {
        "teammates": 0,
        "mode": "subAgent",
        "trigger": "single file edit, simple question, quick fix"
      },
      "squad": {
        "teammates": "2-4",
        "mode": "agentTeam",
        "trigger": "feature implementation, bugfix, refactoring"
      },
      "platoon": {
        "teammates": "5+",
        "mode": "agentTeam",
        "trigger": "large feature, architecture change, security audit, benchmarking"
      }
    },
    "orchestrationPatterns": {
      "plan": "leader",
      "design": "council",
      "do": "swarm",
      "check": "council",
      "act": "leader"
    },
    "playbooks": {
