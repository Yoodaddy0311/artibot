{
  "$schema": "https://json.schemastore.org/claude-code-hooks.json",
  "description": "Artibot v4.6.4 - Claude Code Plugin Hooks (exec-form args[])",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "once": true,
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/_sessionstart-dispatcher.js"
            ],
            "timeout": 30000
          }
        ],
        "priority": "operational",
        "category": "lifecycle"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "tool == \"Write\" || tool == \"Edit\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-write.js"
            ],
            "timeout": 5000
          }
        ],
        "priority": "critical",
        "category": "security"
      },
      {
        "matcher": "tool == \"Bash\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-bash.js"
            ],
            "timeout": 5000
          }
        ],
        "priority": "critical",
        "category": "security"
      },
      {
        "matcher": "tool == \"Write\" || tool == \"Edit\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-write-guard.js"
            ],
            "timeout": 5000
          }
        ],
        "priority": "critical",
        "category": "security"
      },
      {
        "matcher": "tool == \"Write\" || tool == \"Edit\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/git-autopilot-guard.js"
            ],
            "timeout": 5000
          }
        ],
        "priority": "operational",
        "category": "git"
      },
      {
        "matcher": "tool == \"Write\" || tool == \"Edit\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-write-checkpoint.js"
            ],
            "timeout": 5000
          }
        ],
        "priority": "critical",
        "category": "quality"
      },
      {
        "matcher": "tool == \"WebFetch\"",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/webfetch-cache-pre.js"
            ],
            "timeout": 3000
          }
        ],
        "priority": "optional",
        "category": "cache"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/_posttooluse-dispatcher.js"
            ],
            "timeout": 30000
          }
        ],
        "priority": "operational",
        "category": "lifecycle"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-compact.js"
            ],
            "timeout": 8000
          }
        ],
        "priority": "optional",
        "category": "context"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/_stop-dispatcher.js"
            ],
            "timeout": 30000
          }
        ],
        "priority": "operational",
        "category": "lifecycle"
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/_userprompt-dispatcher.js"
            ],
            "timeout": 8000
          }
        ],
        "priority": "operational",
        "category": "lifecycle"
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/subagent-handler.js",
              "start"
            ],
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/workflow-status.js",
              "teammate-update"
            ],
            "timeout": 5000
          }
        ],
        "priority": "optional",
        "category": "team"
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/subagent-handler.js",
              "stop"
            ],
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/agent-evaluator.js"
            ],
            "timeout": 8000
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/workflow-status.js",
              "teammate-update"
            ],
            "timeout": 5000
          }
        ],
        "priority": "optional",
        "category": "team"
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/team-idle-handler.js"
            ],
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/workflow-status.js",
              "teammate-update"
            ],
            "timeout": 5000
          }
        ],
        "priority": "optional",
        "category": "team"
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/team-idle-handler.js"
            ],
            "timeout": 5000
          }
        ],
        "priority": "optional",
        "category": "team"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/clean-state-check.js"
            ],
            "timeout": 5000
          }
        ],
        "priority": "observability",
        "category": "tracking"
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/permission-auto-approve.js"
            ],
            "timeout": 3000
          }
        ],
        "priority": "operational",
        "category": "permission"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/_sessionend-dispatcher.js"
            ],
            "timeout": 30000
          }
        ],
        "priority": "operational",
        "category": "lifecycle"
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/tool-tracker.js",
              "failure"
            ],
            "timeout": 5000
          }
        ],
        "priority": "observability",
        "category": "tracking"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/memory-tracker.js",
              "PostToolUseFailure"
            ],
            "timeout": 5000
          }
        ],
        "priority": "operational",
        "category": "tracking"
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/workflow-status.js",
              "notification"
            ],
            "timeout": 3000
          }
        ],
        "priority": "observability",
        "category": "tracking"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/context-tracker.js"
            ],
            "timeout": 3000
          }
        ],
        "priority": "observability",
        "category": "context"
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "*",
        "once": true,
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/instructions-loaded.js"
            ],
            "timeout": 5000
          }
        ],
        "priority": "operational",
        "category": "lifecycle"
      }
    ]
  }
}
