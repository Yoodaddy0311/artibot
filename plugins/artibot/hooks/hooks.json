{
  "$schema": "https://json.schemastore.org/claude-code-hooks.json",
  "description": "Artibot v4.8.2 - Claude Code Plugin Hooks (shell-form command, args[] not honored by Claude Code; timeout is SECONDS; matcher is a plain tool name or names joined by | — an unanchored regex, so Write|Edit also matches MultiEdit/NotebookEdit; no expression syntax)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "once": true,
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/_sessionstart-dispatcher.js",
            "timeout": 30
          }
        ],
        "priority": "operational",
        "category": "lifecycle"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-write.js",
            "timeout": 5
          }
        ],
        "priority": "critical",
        "category": "security"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-bash.js",
            "timeout": 5
          }
        ],
        "priority": "critical",
        "category": "security"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/bash-risk-guard.js",
            "timeout": 5
          }
        ],
        "priority": "critical",
        "category": "security"
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-write-guard.js",
            "timeout": 5
          }
        ],
        "priority": "critical",
        "category": "security"
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/git-autopilot-guard.js",
            "timeout": 5
          }
        ],
        "priority": "operational",
        "category": "git"
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-write-checkpoint.js",
            "timeout": 5
          }
        ],
        "priority": "critical",
        "category": "quality"
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/route-observe-pre.js",
            "timeout": 5
          }
        ],
        "priority": "optional",
        "category": "observability"
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/webfetch-cache-pre.js",
            "timeout": 5
          }
        ],
        "priority": "optional",
        "category": "cache"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/_posttooluse-dispatcher.js",
            "timeout": 30
          }
        ],
        "priority": "operational",
        "category": "lifecycle"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-compact.js",
            "timeout": 8
          }
        ],
        "priority": "optional",
        "category": "context"
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/post-compact-rehydrate.js",
            "timeout": 8
          }
        ],
        "priority": "optional",
        "category": "context"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/_stop-dispatcher.js",
            "timeout": 30
          }
        ],
        "priority": "operational",
        "category": "lifecycle"
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/_userprompt-dispatcher.js",
            "timeout": 15
          }
        ],
        "priority": "operational",
        "category": "lifecycle"
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/subagent-handler.js start",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/workflow-status.js teammate-update",
            "timeout": 5
          }
        ],
        "priority": "optional",
        "category": "team"
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/_subagentstop-dispatcher.js",
            "timeout": 15
          }
        ],
        "priority": "optional",
        "category": "team"
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/team-idle-handler.js",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/workflow-status.js teammate-update",
            "timeout": 5
          }
        ],
        "priority": "optional",
        "category": "team"
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/team-idle-handler.js",
            "timeout": 5
          }
        ],
        "priority": "optional",
        "category": "team"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/clean-state-check.js",
            "timeout": 5
          }
        ],
        "priority": "observability",
        "category": "tracking"
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/permission-auto-approve.js",
            "timeout": 5
          }
        ],
        "priority": "operational",
        "category": "permission"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/_sessionend-dispatcher.js",
            "timeout": 30
          }
        ],
        "priority": "operational",
        "category": "lifecycle"
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/tool-tracker.js failure",
            "timeout": 5
          }
        ],
        "priority": "observability",
        "category": "tracking"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/memory-tracker.js PostToolUseFailure",
            "timeout": 5
          }
        ],
        "priority": "operational",
        "category": "tracking"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/post-tool-failure-advisor.js",
            "timeout": 5
          }
        ],
        "priority": "operational",
        "category": "feedback"
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/workflow-status.js notification",
            "timeout": 5
          }
        ],
        "priority": "observability",
        "category": "tracking"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/context-tracker.js",
            "timeout": 5
          }
        ],
        "priority": "observability",
        "category": "context"
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "*",
        "once": true,
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/instructions-loaded.js",
            "timeout": 5
          }
        ],
        "priority": "operational",
        "category": "lifecycle"
      }
    ]
  }
}
