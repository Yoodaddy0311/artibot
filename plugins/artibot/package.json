{
  "name": "artibot",
  "version": "4.19.2",
  "description": "Artibot - Claude Code orchestration plugin runtime",
  "private": true,
  "type": "module",
  "main": "./lib/core/index.js",
  "bin": {
    "artibot": "./bin/artibot.js",
    "artibot-dashboard": "./bin/artibot-dashboard.mjs",
    "artibot-mcp": "./bin/artibot-mcp.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "validate": "node scripts/validate.js",
    "validate:bin": "node scripts/validate-bin.js",
    "lint": "eslint bin/ lib/ scripts/ tests/",
    "lint:fix": "eslint --fix bin/ lib/ scripts/ tests/",
    "ci": "node scripts/validate.js && node scripts/validate-bin.js && npm run skill:check && npm run lint && npm test && npm run eval:runtime:check",
    "ci:coverage": "node scripts/validate.js && npm run lint && node scripts/ci/validate-coverage.js",
    "test": "vitest run --reporter=default --reporter=./tests/reporters/test-status-reporter.js",
    "test:evals": "vitest run tests/evals",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "node scripts/ci/validate-coverage.js --check",
    "eval:runtime": "node scripts/evals/run-runtime-task-suite.js",
    "eval:runtime:check": "node scripts/ci/validate-runtime-evals.js",
    "skill:check": "node scripts/gen-skill-docs.js --check",
    "skill:check:json": "node scripts/gen-skill-docs.js --json",
    "skill:report": "node scripts/gen-skill-docs.js --report",
    "validate:readme:claims": "node scripts/ci/validate-readme-claims.js",
    "validate:readme:claims:full": "node scripts/ci/validate-readme-claims.js --full",
    "release:check": "node scripts/release-check.js",
    "sync:local": "bash scripts/sync-local.sh",
    "release": "npm run release:check && npm run ci && npm run sync:local"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.2.1",
    "globals": "^17.3.0",
    "vitest": "^4.0.18"
  }
}
