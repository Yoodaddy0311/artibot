!plugins/artibot/docs/adr/**
plugins/artibot/coverage/
plugins/artibot/image.png
# Runtime state files (token usage, sessions, hashes) — never commit; caused rebase corruption v3.9.0→v3.9.1
plugins/artibot/runtime/
plugins/artibot/.claude-cache/
NVIDIA Corporation/
*.jpeg
*.png
!assets/*.jpeg
!assets/*.png

# Codex CLI auto-generated files
/.agents/
/AGENTS.md
/agents/
CLAUDE.local.md

# Defense against Windows path-as-filename bug (vitest/tmp output misconfig)
C:Users*
*vitest-out.json
*AppDataLocalTemp*

# Squad C (AD-23/24/37/38/40): hook-managed runtime data — never commit
runtime/cache/
runtime/state/
runtime/autopilot/
!runtime/cache/webfetch/.gitkeep
!runtime/state/.gitkeep

# Generated reports / analyses / plugin design proposals (committed history kept; new files ignored)
reports/
**/_design/
**/_analysis/
**/_research/
**/_proposals/
*-design-spec.md
*-analysis-report.md

# Session handoffs — committed for cross-session/cross-machine visibility
!.artibot/HANDOFF.md
!.artibot/handoffs/

# Auto-generated per-session timeline log — hooks rewrite it every session,
# so it only adds dirty-tree noise to git status / /save. Read from the working
# tree by hooks (session-notes.js, dev-verify-gate.js, pr-description-builder.js);
# no consumer requires it to be git-tracked. Not cross-machine state (unlike HANDOFF.md).
.artibot/SESSION-NOTES.md

# Ambient Conversation Ledger — per-session denoised conversation archive.
# Local-only (DATA POLICY): contains verbatim user/assistant conversation text
# (secret-redacted, but still private). NEVER commit — keep out of git entirely.
# `**/` so it matches whether the hook's projectRoot is the repo root or a
# nested cwd (e.g. plugins/artibot/.artibot/ledger/ during in-repo dev).
**/.artibot/ledger/
