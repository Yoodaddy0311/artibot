# Internal development docs — plugin surface is plugins/artibot/README.md only
# (use /* pattern so we can re-include specific user-facing files)
plugins/artibot/docs/*
# User-facing docs (linked from README) must be tracked
!plugins/artibot/docs/SCHEDULED-JOBS.md
plugins/artibot/coverage/
plugins/artibot/image.png
# Runtime state files (token usage, sessions, hashes) — never commit; caused rebase corruption v3.9.0→v3.9.1
plugins/artibot/runtime/
plugins/artibot/.claude-cache/
NVIDIA Corporation/
*.jpeg
*.png
!assets/*.jpeg
!assets/*.png

# Codex CLI auto-generated files
/.agents/
/AGENTS.md
/agents/
CLAUDE.local.md

# Defense against Windows path-as-filename bug (vitest/tmp output misconfig)
C:Users*
*vitest-out.json
*AppDataLocalTemp*

# Squad C (AD-23/24/37/38/40): hook-managed runtime data — never commit
runtime/cache/
runtime/state/
!runtime/cache/webfetch/.gitkeep
!runtime/state/.gitkeep

# Generated reports / analyses / plugin design proposals (committed history kept; new files ignored)
reports/
**/_design/
**/_analysis/
**/_research/
**/_proposals/
*-design-spec.md
*-analysis-report.md
