# Internal development docs — plugin surface is plugins/artibot/README.md only
# (use /* pattern so we can re-include specific user-facing files)
plugins/artibot/docs/*
# User-facing docs (linked from README) must be tracked
!plugins/artibot/docs/SCHEDULED-JOBS.md
!plugins/artibot/docs/MCP-SETUP.md
!plugins/artibot/docs/PRD-TELEGRAM-MCP.md
!plugins/artibot/docs/PRD-EFFORT-DYNAMIC-WORKFLOW.md
